<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="e_line.App.SettingsPage"
             xmlns:local="clr-namespace:e_line.App"
             Title="Configurações">
    <VerticalStackLayout Padding="30" Spacing="15">
        <Label 
            Text="Configurações"
            FontSize="32"
            HorizontalOptions="Center" />

        <Label 
            Text="Selecione seu Veículo Elétrico:"
            FontSize="18"
            Margin="0,20,0,0"/>

        <Picker x:Name="EVPicker"
                Title="Escolha um modelo..."
                ItemDisplayBinding="{Binding DisplayName}"
                SelectedIndexChanged="OnEVPickerSelectedIndexChanged"
                x:DataType="local:EVModel" />

    </VerticalStackLayout>
</ContentPage>
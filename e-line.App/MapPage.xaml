<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="e_line.App.MapPage"
             Title="Map">
    <Grid>
        <toolkit:MediaElement x:Name="AudioPlayer"
                              IsVisible="False"/>

        <WebView x:Name="mapWebView" />

        <Button x:Name="PlanRouteButton"
                Text="Plan Mock Route"
                Clicked="OnPlanRouteClicked"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="20" />
        
        <ImageButton Source="microphone.svg"
                x:Name="VoiceButton"
                Clicked="OnVoiceClicked"
                HeightRequest="50"
                WidthRequest="50"
                CornerRadius="25"
                BackgroundColor="DodgerBlue"
                Padding="12"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20" />

        <Label x:Name="TranscriptionLabel"
           Text="Press the mic and speak..."
           TextColor="White"
           BackgroundColor="#80000000"
           Padding="10"
           HorizontalOptions="Center"
           VerticalOptions="Start"
           Margin="20"
           IsVisible="false" />
    </Grid>
</ContentPage>